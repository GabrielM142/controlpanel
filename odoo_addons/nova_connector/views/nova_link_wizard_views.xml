<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nova_link_wizard_form" model="ir.ui.view">
        <field name="name">nova.link.wizard.form</field>
        <field name="model">nova.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Código de vinculación NOVA">
                <p>Ingrese este código en NOVA (Fuentes de datos → Vincular). Se muestra una sola vez y vence en 30 minutos.</p>
                <group>
                    <field name="token"/>
                    <field name="installation_uuid"/>
                    <field name="expires_at"/>
                </group>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
