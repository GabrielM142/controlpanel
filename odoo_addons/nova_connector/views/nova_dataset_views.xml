<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nova_export_dataset_tree" model="ir.ui.view">
        <field name="name">nova.export.dataset.tree</field>
        <field name="model">nova.export.dataset</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" decoration-muted="not available" decoration-danger="missing_required">
                <field name="key"/>
                <field name="model_name"/>
                <field name="addon"/>
                <field name="version"/>
                <field name="mode"/>
                <field name="available"/>
                <field name="enabled"/>
                <field name="missing_required"/>
                <field name="missing_optional" optional="hide"/>
                <field name="last_error" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_nova_export_dataset_form" model="ir.ui.view">
        <field name="name">nova.export.dataset.form</field>
        <field name="model">nova.export.dataset</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_sync_registry" type="object" string="Revisar campos" groups="nova_connector.group_nova_admin"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="name"/>
                            <field name="model_name"/>
                            <field name="addon"/>
                            <field name="version"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="enabled"/>
                            <field name="available"/>
                            <field name="scan_enabled"/>
                            <field name="reconcile_enabled"/>
                            <field name="sensitive_enabled"/>
                        </group>
                    </group>
                    <group string="Campos exportados">
                        <field name="exported_fields" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Campos faltantes">
                        <field name="missing_required"/>
                        <field name="missing_optional"/>
                    </group>
                    <group string="Campos adicionales autorizados (adaptador de cliente)">
                        <field name="extra_field_ids" widget="many2many_tags" nolabel="1" colspan="2"
                               domain="[('model', '=', model_name), ('store', '=', True)]"/>
                    </group>
                    <group string="Último error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nova_export_dataset" model="ir.actions.act_window">
        <field name="name">Datasets NOVA</field>
        <field name="res_model">nova.export.dataset</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
