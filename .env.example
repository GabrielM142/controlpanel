# ---------------------------------------------------------------- frontend (Vite, build time; public!)
# Leave empty for explicit DEMO mode (labelled example data). Never put secrets in VITE_* variables.
VITE_NOVA_API_URL=

# ---------------------------------------------------------------- API + worker (server only)
# demo | live. live requires DATABASE_URL; it never falls back to demo numbers.
APP_MODE=demo
DATABASE_URL=
# Group role used per transaction (SET LOCAL ROLE). API: nova_api, worker: nova_worker. "none" disables.
NOVA_DB_ROLE=
PGPOOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=15000
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Odoo API keys at rest. Keep in a secret manager.
NOVA_SECRET_KEY=
# Exact frontend origins allowed to call the API with credentials (comma separated).
NOVA_CORS_ORIGINS=https://controlpanel.example.com
NOVA_COOKIE_SECURE=true
NOVA_SESSION_HOURS=12
PORT=8787
# Staging only: allow http:// Odoo URLs and/or internal hosts (comma separated). Never in production.
NOVA_ALLOW_INSECURE_SOURCES=false
NOVA_SOURCE_HOST_ALLOWLIST=
# Worker
NOVA_WORKER_CONCURRENCY=2
NOVA_WORKER_POLL_SECONDS=60
NOVA_MAX_PART_BYTES=8388608
NOVA_MAX_RUN_PARTS=20000
# Staging compose only
NOVA_DB_OWNER_PASSWORD=
