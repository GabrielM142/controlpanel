{
  "name": "controlpanel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --host 127.0.0.1",
    "api": "node --env-file=.env server/index.mjs",
    "worker": "node --env-file=.env worker/run.mjs",
    "migrate": "node --env-file=.env sql/migrate.mjs",
    "admin": "node --env-file=.env scripts/admin.mjs",
    "test": "node --test",
    "test:py": "python -m unittest discover -s tests/py -v",
    "contracts": "python odoo_addons/tools/gen_contracts.py",
    "addons:check": "python odoo_addons/tools/check_addons.py",
    "addons:zip": "python odoo_addons/tools/package.py",
    "docs:blocks": "node scripts/blocks-matrix.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "lucide-react": "^1.47.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "parse5": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
