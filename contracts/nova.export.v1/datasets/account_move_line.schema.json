    "move_id",
    "account_id",
    "partner_id",
    "product_id",
    "product_uom_id",
    "quantity",
    "price_unit",
    "discount",
    "price_subtotal",
    "price_total",
    "balance",
    "debit",
    "credit",
    "amount_currency",
    "currency_id",
    "company_id",
    "date",
    "date_maturity",
    "display_type",
    "amount_residual",
