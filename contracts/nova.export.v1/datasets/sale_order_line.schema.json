{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.local/contracts/nova.export.v1/datasets/sale_order_line.schema.json",
  "title": "sale_order_line v1 (sale.order.line)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "write_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "order_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "product_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "product_uom": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "product_uom_qty": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "qty_delivered": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "qty_invoiced": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "qty_to_invoice": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "price_unit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "discount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "price_subtotal": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "price_total": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "company_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "currency_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "display_type": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "salesman_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "order_partner_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "purchase_price": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "extra": {
      "type": "object",
      "maxProperties": 40
    }
  },
  "required": [
    "write_date",
    "order_id",
    "product_id",
    "product_uom",
    "product_uom_qty",
    "qty_delivered",
    "qty_invoiced",
    "qty_to_invoice",
    "price_unit",
    "discount",
    "price_subtotal",
    "price_total",
    "company_id",
    "currency_id",
    "state",
    "display_type",
    "salesman_id",
    "order_partner_id"
  ]
}
