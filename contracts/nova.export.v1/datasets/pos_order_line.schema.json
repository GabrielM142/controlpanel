{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.local/contracts/nova.export.v1/datasets/pos_order_line.schema.json",
  "title": "pos_order_line v1 (pos.order.line)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "write_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "order_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "product_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "qty": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "price_unit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "discount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "price_subtotal": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "price_subtotal_incl": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "total_cost": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "is_total_cost_computed": {
      "type": "boolean"
    },
    "refunded_orderline_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "company_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "full_product_name": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "extra": {
      "type": "object",
      "maxProperties": 40
    }
  },
  "required": [
    "write_date",
    "order_id",
    "product_id",
    "qty",
    "price_unit",
    "discount",
    "price_subtotal",
    "price_subtotal_incl",
    "company_id",
    "full_product_name"
  ]
}
