{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.local/contracts/nova.export.v1/datasets/product_category.schema.json",
  "title": "product_category v1 (product.category)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "write_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "complete_name": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "extra": {
      "type": "object",
      "maxProperties": 40
    }
  },
  "required": [
    "write_date",
    "name",
    "complete_name",
    "parent_id"
  ]
}
