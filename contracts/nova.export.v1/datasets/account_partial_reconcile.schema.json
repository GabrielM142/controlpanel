{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.local/contracts/nova.export.v1/datasets/account_partial_reconcile.schema.json",
  "title": "account_partial_reconcile v1 (account.partial.reconcile)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "write_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "debit_move_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "credit_move_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "amount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "debit_amount_currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "credit_amount_currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "max_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "company_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "full_reconcile_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "extra": {
      "type": "object",
      "maxProperties": 40
    }
  },
  "required": [
    "write_date",
    "debit_move_id",
    "credit_move_id",
    "amount",
    "debit_amount_currency",
    "credit_amount_currency",
    "max_date",
    "company_id",
    "full_reconcile_id"
  ]
}
